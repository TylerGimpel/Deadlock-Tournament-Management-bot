# Dependencies - regenerated via `npm install`, not tracked
node_modules/

# Cloudflare's local build/state cache, created whenever `wrangler` runs
.wrangler/

# Local, non-secret settings the installer remembers between runs
# (e.g. your Worker name) - see bin/bot-config.js. Personal to whoever
# ran setup/upgrade locally; shouldn't be shared or committed.
bin/saved-settings.json

# OS junk
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/

# If a local secrets file is ever added later (none currently exist -
# secrets go straight to `wrangler secret put` / Apps Script Script
# Properties, never to disk here), ignore it too:
.env
.env.*
# Dev-only personal tool for pushing Spreadsheet Code updates to the
# private TEMPLATE spreadsheet (hardcodes its Script ID) - never
# shipped, never meant for end users.
bin/upgrade-template-sheet.js
run-upgrade-template.bat
bin/run-upgrade-template.ps1
bin/template-upgrade-workspace/
bin/template-backups/
git-push.bat

# Scratch workspace/backups clasp creates when upgrade-sheet.js is run
# from a local checkout (already gitignored when shipped standalone in
# the installer zip, just never had a rule here for the repo itself)
bin/sheet-upgrade-workspace/
bin/sheet-backups/
bin/.clasp.json

